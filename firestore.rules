rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Push subscription endpoints/keys are only ever read or written by
    // the Admin SDK (server) — never exposed to the public client.
    match /push_subscriptions/{id} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
